# Salin ke `.env` lalu isi sesuai project Supabase Anda:
#   cp .env.example .env
#
# Nilai project pesantren ini sudah tertanam sebagai bawaan di `nuxt.config.ts`,
# jadi `npm run dev` tetap jalan tanpa `.env`. Berkas ini diperlukan kalau
# Anda menunjuk ke project lain — misalnya pesantren kedua atau lingkungan uji.
#
# Ambil keduanya di: Dashboard -> Project Settings -> API
#   URL             = Project URL
#   PUBLISHABLE KEY = kunci `sb_publishable_...` (BUKAN `service_role`)
#
# Kunci `service_role` tidak boleh masuk berkas ini maupun ke dalam aplikasi:
# ia menembus RLS, dan RLS-lah satu-satunya penjaga data santri.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
